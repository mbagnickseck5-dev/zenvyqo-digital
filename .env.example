# ── Site ────────────────────────────────────────────────────────────────
# URL publique du site (sans barre oblique finale). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp Business au format international, chiffres seulement.
# Vide = valeur par défaut de src/lib/site.ts (15145525923).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Coordonnées affichées sur le site. Vides = valeurs par défaut de src/lib/site.ts
# (contactzenvyqo@gmail.com et +1 514 552-5923).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ── Supabase (enregistrement des prospects) ─────────────────────────────
# Sans ces deux valeurs, le formulaire fonctionne en MODE DÉMO :
# la demande est validée et journalisée côté serveur, mais pas enregistrée.
SUPABASE_URL=
# Clé "service_role" : SERVEUR UNIQUEMENT, ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : URL d'un webhook (Make, Zapier, n8n, Slack…) qui reçoit chaque demande en JSON.
LEADS_WEBHOOK_URL=

# ── Stripe (frais de création + abonnement) ─────────────────────────────
# Mettre "true" pour afficher le bouton de paiement après l'envoi du formulaire.
NEXT_PUBLIC_STRIPE_ENABLED=false
# Clé secrète de TEST (sk_test_…). Une clé réelle (sk_live_…) est refusée
# tant que STRIPE_ALLOW_LIVE n'est pas "true".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
